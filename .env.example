# ==========================================
# TRIAGE Research Lab - Environment Variables
# ==========================================

# Supabase - Public (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase - Server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NVIDIA NIM API - Server only
# Primary key (Nemotron 3.5 Parse):
NVIDIA_API_KEY=nvapi-your_primary_nvidia_key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Secondary key (Nemotron Rerank 8B):
NVIDIA_KEY_RERANK=nvapi-your_rerank_key
# Domain key (RFD4 Proteina):
NVIDIA_KEY_PROTEIN=nvapi-your_protein_key

# Google Gemini API - Server only
# Gemini Primary (Gemini 2):
GEMINI_API_KEY=AQ.your_gemini_key_primary
# Gemini Backup / Secondary (Gemini 1):
GEMINI_API_KEY_BACKUP=AQ.your_gemini_key_backup
GEMINI_MODEL=gemini-2.5-flash

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
